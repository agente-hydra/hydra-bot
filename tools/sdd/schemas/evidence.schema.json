{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidenceCollection",
  "type": "object",
  "required": ["repoRoot", "timestamp", "items"],
  "properties": {
    "repoRoot": { "type": "string" },
    "timestamp": { "type": "string" },
    "degraded": {
      "type": "array",
      "items": { "type": "string" }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "ref", "weight", "payload"],
        "properties": {
          "id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["structure", "cochange", "dependency", "spec", "memory", "ops"]
          },
          "ref": { "type": "string" },
          "weight": { "type": "number", "minimum": 0 },
          "payload": { "type": "object" }
        }
      }
    }
  }
}
