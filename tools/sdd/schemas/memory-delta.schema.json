{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MemoryDelta",
  "type": "object",
  "required": ["specialistId", "featureId", "date", "context", "ruleLearned", "risk", "antiPattern", "anchor"],
  "properties": {
    "specialistId": { "type": "string" },
    "featureId": { "type": "string" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "context": { "type": "string" },
    "ruleLearned": { "type": "string" },
    "risk": { "type": "string" },
    "antiPattern": { "type": "string" },
    "anchor": { "type": "string" }
  }
}
