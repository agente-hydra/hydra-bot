{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Changeset",
  "type": "object",
  "required": ["specId", "owned", "shared", "baselineDirty"],
  "properties": {
    "specId": { "type": "string" },
    "owned": {
      "type": "array",
      "items": { "type": "string" }
    },
    "shared": {
      "type": "array",
      "items": { "type": "string" }
    },
    "baselineDirty": {
      "type": "array",
      "items": { "type": "string" }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "paths", "summary"],
        "properties": {
          "name": { "type": "string" },
          "paths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "summary": { "type": "string" }
        }
      }
    }
  }
}
