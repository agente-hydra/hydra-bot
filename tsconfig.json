{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": [
      "node"
    ],
    "esModuleInterop": true
  },
  "include": [
    "src/hydra-sync/**/*.ts",
    "src/workers/oficina-agent/**/*.ts"
  ]
}
