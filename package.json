{
  "name": "hydra-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hydra operational bot and workshop crawler",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "node webhook-listener.js",
    "crawl:full": "bash scripts/run-hydra-daily-full.sh",
    "crawl:finance": "bash scripts/run-hydra-hourly-finance.sh",
    "mcp": "tsx src/hydra-sync/mcp_server.ts",
    "verify": "node deploy/verify.cjs",
    "test": "python3 -m unittest discover -s deploy/tests -v",
    "typecheck": "tsc -p tsconfig.hydra.json --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "@modelcontextprotocol/sdk": "1.30.1",
    "better-sqlite3": "13.0.3",
    "date-fns": "4.4.0",
    "dotenv": "17.4.2",
    "fastify": "5.10.0",
    "playwright": "1.62.0",
    "sqlite-vec": "0.1.9",
    "xlsx": "0.18.5",
    "tsx": "4.23.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.1"
  }
}
